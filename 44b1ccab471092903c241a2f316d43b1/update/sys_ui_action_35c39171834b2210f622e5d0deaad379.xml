        <onclick/>
        <order>100</order>
        <script><![CDATA[function onClickLinkToStoryDefect() {
  var storyId = prompt("Enter Story ID (e.g., STRY0001):");
  var defectId = prompt("Enter Defect ID (e.g., DFCT0001):");

  if (!storyId && !defectId) {
    alert("You must enter at least one Story or Defect ID.");
    return;
  }

  var ga = new GlideAjax('TraceFileAjax');
  ga.addParam('sysparm_name', 'linkFile');
  ga.addParam('sysparm_file_id', g_form.getUniqueValue());
  ga.addParam('sysparm_story', storyId);
  ga.addParam('sysparm_defect', defectId);

  ga.getXMLAnswer(function(response) {
    alert(response);
    g_form.clearMessages();
    g_form.addInfoMessage(response);
  });
}
]]></script>
